{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/unbloat/scripts/unbloat-check.mjs\" --guard",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/unbloat/scripts/unbloat-check.mjs\" --session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/unbloat/scripts/unbloat-check.mjs\" --turn-start",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/unbloat/scripts/unbloat-check.mjs\" --stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
